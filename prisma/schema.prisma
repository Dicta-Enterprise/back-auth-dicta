generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accesos {
  id              Int               @id @default(autoincrement())
  codigo          String            @unique @db.VarChar(50)
  descripcion     String?           @db.VarChar(200)
  estado          Int?              @default(1) @db.SmallInt
  detalle_accesos detalle_accesos[]
}

model detalle_accesos {
  id       Int     @id @default(autoincrement())
  idrol    Int
  idacceso Int
  acceso   accesos @relation(fields: [idacceso], references: [id])
  rol      rol     @relation(fields: [idrol], references: [id])

  @@unique([idrol, idacceso])
}

model departamento {
  id              Int         @id @default(autoincrement())
  idpais          Int
  nombre          String      @db.VarChar(80)
  estado          Int         @default(1) @db.SmallInt
  fechacreacion   DateTime    @default(now()) @db.Timestamp(6)
  fechaactualizar DateTime?   @db.Timestamp(6)
  pais            pais        @relation(fields: [idpais], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_departamento_pais")
  provincia       provincia[]
}

model pais {
  id              Int            @id @default(autoincrement())
  nombre          String         @db.VarChar(80)
  estado          Int            @default(1) @db.SmallInt
  fechacreacion   DateTime       @default(now()) @db.Timestamp(6)
  fechaactualizar DateTime?      @db.Timestamp(6)
  departamento    departamento[]
  persona         persona[]
}

model perfil {
  id        Int       @id @default(autoincrement())
  nombre    String?   @db.VarChar(50)
  password  String?   @db.VarChar(255)
  estado    Int?      @db.SmallInt
  imageurl  String?   @db.Text
  idusuario Int?
  idrol     Int?
  rol       rol?      @relation(fields: [idrol], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios  usuarios? @relation(fields: [idusuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model persona {
  id           Int       @id @default(autoincrement())
  nombre       String?   @db.VarChar(50)
  apellidopat  String?   @db.VarChar(50)
  apellidomat  String?   @db.VarChar(50)
  documento    Int?
  telefono     Int?
  idusuario    Int?
  codigopostal String?   @db.VarChar(10)
  idpais       Int?
  pais         pais?     @relation(fields: [idpais], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_persona_pais")
  usuarios     usuarios? @relation(fields: [idusuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model provincia {
  id              Int          @id @default(autoincrement())
  iddepartamento  Int
  nombre          String       @db.VarChar(80)
  estado          Int          @default(1) @db.SmallInt
  fechacreacion   DateTime     @default(now()) @db.Timestamp(6)
  fechaactualizar DateTime?    @db.Timestamp(6)
  departamento    departamento @relation(fields: [iddepartamento], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_provincia_departamento")
}

model rol {
  id              Int               @id
  nombrerol       String?           @db.VarChar(50)
  estado          Int?              @db.SmallInt
  descripcion     String?           @db.VarChar(200)
  tipo            String?           @db.VarChar(50)
  detalle_accesos detalle_accesos[]
  detallepermisos detallepermisos[]
  perfil          perfil[]
  usuarios        usuarios[]
}

model usuarios {
  id                    Int                  @id @default(autoincrement())
  username              String               @db.VarChar(50)
  email                 String               @unique @db.VarChar(150)
  auth_provider         String               @default("LOCAL") @db.VarChar(20)
  password              String?              @db.VarChar(255)
  fechadecreacion       DateTime?
  estado                Int?                 @db.SmallInt
  idrol                 Int?                 @default(4)
  googleId              String?              @unique
  perfil                perfil[]
  persona               persona[]
  terminos_condiciones  Boolean              @default(false)
  reset_code            String?              @db.VarChar(6)
  reset_code_expires    DateTime?            @db.Timestamp(6)
  reset_attempts        Int                  @default(0)
  verify_code           String?              @db.VarChar(6)
  verify_code_expires   DateTime?            @db.Timestamp(6)
  verify_attempts       Int                  @default(0)
  rol                   rol?                 @relation(fields: [idrol], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cuenta_asociada       cuenta_asociada[]    @relation("CuentaAsociadaUsuario")
  cuenta_asociada_padre cuenta_asociada[]    @relation("CuentaAsociadaPadre")
  invitacionfamiliar    invitacionfamiliar[]
}

model permiso {
  id              Int               @id @default(autoincrement())
  codigo          String            @unique @db.VarChar(50)
  nombre          String            @db.VarChar(100)
  descripcion     String?           @db.VarChar(200)
  estado          Int               @default(1) @db.SmallInt
  detallepermisos detallepermisos[]
}

model detallepermisos {
  id            Int      @id @default(autoincrement())
  idrol         Int
  idpermiso     Int
  estado        Int      @default(1) @db.SmallInt
  fechacreacion DateTime @default(now()) @db.Timestamp(6)
  permiso       permiso  @relation(fields: [idpermiso], references: [id])
  rol           rol      @relation(fields: [idrol], references: [id])

  @@unique([idrol, idpermiso])
}

enum TipoCuentaFamiliar {
  NINO
  JOVEN
}

enum EstadoCuentaAsociada {
  ACTIVA
  INACTIVA
}

model cuenta_asociada {
  id              Int                  @id @default(autoincrement())
  idpadre         Int
  idusuario       Int?
  idinvitacion    Int?                 @unique
  correo          String?              @db.VarChar(150)
  alias           String?              @db.VarChar(50)
  fechanacimiento DateTime?
  tipocuenta      TipoCuentaFamiliar
  estado          EstadoCuentaAsociada @default(ACTIVA)
  fechacreacion   DateTime             @default(now()) @db.Timestamp(6)

  padre                  usuarios             @relation("CuentaAsociadaPadre", fields: [idpadre], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cuenta_asociada_padre")
  usuarios               usuarios?            @relation("CuentaAsociadaUsuario", fields: [idusuario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cuenta_asociada_usuarios")
  invitacion             invitacionfamiliar?  @relation(fields: [idinvitacion], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_cuenta_asociada_invitacion")
  permisoCuenta          permisoCuenta?
  cursoasignado          cursoasignado[]
  invitacionesFamiliares InvitacionFamiliar[]

  @@index([idpadre])
  @@index([idusuario])
}

model permisoCuenta {
  id                      Int      @id @default(autoincrement())
  idCuentaAsociada        Int      @unique
  puedeVerCursos          Boolean  @default(true)
  puedeComprarCursos      Boolean  @default(false)
  puedeVerProgreso        Boolean  @default(true)
  puedeUsarChat           Boolean  @default(false)
  puedeDescargarMaterial  Boolean  @default(false)
  puedeVerCertificados    Boolean  @default(false)
  tiempoMaximoDiario      Int?
  horarioInicio           String?
  horarioFin              String?
  fechaCreacion           DateTime @default(now())
  fechaActualizacion      DateTime @updatedAt
 
  cuentaAsociada          cuenta_asociada @relation(fields: [idCuentaAsociada], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_permisoCuenta_cuentaAsociada")
}

enum EstadoCursoAsignado {
  ACTIVO
  COMPLETADO
  CANCELADO
}

model cursoasignado {
  id               Int                 @id @default(autoincrement())
  idcuentaasociada Int
  idcurso          String              @db.Char(24)
  fechaasignacion  DateTime            @default(now()) @db.Timestamp(6)
  estado           EstadoCursoAsignado @default(ACTIVO)

  cuentaAsociada cuenta_asociada @relation(fields: [idcuentaasociada], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cursoasignado_cuentaasociada")

  @@index([idcuentaasociada])
}

enum EstadoInvitacion {
  PENDIENTE
  ACEPTADA
  EXPIRADA
  CANCELADA
}

model invitacionfamiliar {
  id              Int                @id @default(autoincrement())
  idpadre         Int
  correo          String
  nombre          String
  alias           String
  fechanacimiento DateTime
  tipocuenta      TipoCuentaFamiliar
  token           String             @unique
  estado          EstadoInvitacion   @default(PENDIENTE)
  fechaexpiracion DateTime
  fechaaceptacion DateTime?
  fechacreacion   DateTime           @default(now())
  usuarios        usuarios           @relation(fields: [idpadre], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cuentaAsociada  cuenta_asociada?

  @@index([correo])
  @@index([token])
}

model InvitacionFamiliar {
  id               String           @id @default(cuid())
  idCuentaAsociada Int
  correo           String           @db.VarChar(150)
  token            String           @unique
  estado           EstadoInvitacion @default(PENDIENTE)
  cursoId          String           @db.Char(24)
  fechaExpiracion  DateTime
  fechaAceptacion  DateTime?
  fechaCreacion    DateTime         @default(now())

  cuentaAsociada cuenta_asociada @relation(fields: [idCuentaAsociada], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_invitacionFamiliar_cuentaAsociada")

  @@index([correo])
}
